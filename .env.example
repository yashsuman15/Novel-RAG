# ============================================================================
# RAG Application Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!
# ============================================================================

# ----------------------------------------------------------------------------
# Anthropic API Configuration
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-api-key-here

# ----------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# Vector Store Configuration
# ----------------------------------------------------------------------------
VECTOR_STORE_PATH=data/vector_store
VECTOR_STORE_COLLECTION=rag_collection
BATCH_SIZE=5000

# ----------------------------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------------------------
# Embedding model from HuggingFace
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
# Options: cuda, cpu, auto (auto-detects)
EMBEDDING_DEVICE=auto
NORMALIZE_EMBEDDINGS=true

# Reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------------------------
# LLM Configuration
# ----------------------------------------------------------------------------
# Primary LLM for answer generation
LLM_MODEL=claude-opus-4-5
# Lightweight LLM for query expansion
LLM_LITE_MODEL=claude-sonnet-4-5
# Extended thinking token budget
LLM_THINKING_BUDGET=10000
# Temperature (must be 1.0 for extended thinking)
LLM_TEMPERATURE=1.0
# Request timeout in seconds
LLM_TIMEOUT=120

# ----------------------------------------------------------------------------
# Text Splitting Configuration
# ----------------------------------------------------------------------------
# Characters per chunk
CHUNK_SIZE=1000
# Character overlap between chunks
CHUNK_OVERLAP=300

# ----------------------------------------------------------------------------
# Retrieval Configuration
# ----------------------------------------------------------------------------
# Total chunks to retrieve before reranking
RETRIEVAL_TOTAL_CHUNKS=20
# Top K chunks after reranking
RETRIEVAL_RERANK_TOP_K=10
# Number of expanded queries to generate
RETRIEVAL_NUM_QUERIES=5

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Options: json, text
LOG_FORMAT=json